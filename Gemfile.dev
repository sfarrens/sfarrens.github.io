# Local development only — bypasses github-pages to support Ruby 4.0.
# Use: BUNDLE_GEMFILE=Gemfile.dev bundle exec jekyll serve
source 'https://rubygems.org'

gemspec

gem 'base64'
gem 'jekyll', '~> 3.10'
gem 'jekyll-target-blank', '>= 2.0'
gem 'kramdown-parser-gfm', '~> 1.1'
gem 'webrick', '~> 1.7'
